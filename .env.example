# Copia a .env.local en tu maquina. En Vercel: Settings > Environment Variables.
# Nunca subas valores reales al repositorio.
#
# Local: host directo db.<id>.supabase.co:5432
# Vercel: si pones el host directo, la app lo cambia sola al pooler IPv4 (aws-1, no aws-0).
# Si prefieres ponerlo a mano en Vercel:
# postgresql://postgres.<id>:<CLAVE>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

DATABASE_URL=
SESSION_SECRET=
